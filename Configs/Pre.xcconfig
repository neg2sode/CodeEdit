//
//  Pre.xcconfig
//  CodeEdit
//
//  Created by Johnathan Baird on 3/11/24.
//

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

CE_APPICON_NAME = AppIconPre
CE_VERSION_POSTFIX = -pre
CE_COPYRIGHT = Copyright © 2022-2025 CodeEdit

// ---------------------------------------------------------------------------
// Nightly-only build settings (Pre configuration).
//
// 1. Use the non-sandboxed entitlements. The App Sandbox makes the integrated
//    terminal unusable: zsh cannot read ~/.zprofile, cannot setpgid() for job
//    control, cannot lock ~/.zsh_history, and subprocesses such as `xcrun`
//    refuse to run at all. Alpha/Beta/Release keep the sandbox.
// 2. ENABLE_APP_SANDBOX is set to NO directly in the project's Pre build
//    configuration: it is a special Xcode setting whose project-level value takes
//    precedence over xcconfig, and it injects the app-sandbox entitlement
//    independently of the entitlements file.
// ---------------------------------------------------------------------------
CE_ENTITLEMENTS = CodeEdit/CodeEdit-nightly.entitlements


// Shown in the About window and Welcome screen. Empty in Alpha/Beta/Release,
// so those configurations present as ordinary (non-nightly) builds.
CE_BUILD_IDENTITY = Unofficial nightly build
// NOTE: xcconfig treats "//" as a comment start, so a URL cannot be written
// literally. Assemble the scheme separator from a variable instead.
CE_SLASHES = /
CE_BUILD_IDENTITY_URL = https:$(CE_SLASHES)/github.com/neg2sode/CodeEdit/blob/main/BUILD-NOTES.md
